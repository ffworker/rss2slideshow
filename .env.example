# Host-local configuration. Keep real credentials out of Git.
BIND_IP=127.0.0.1
HTTP_PORT=8085
DISPLAY_TZ=Europe/Berlin
SLIDE_SECONDS=20

# /admin requires both credentials. Restrict access or protect with HTTPS.
ADMIN_USER=
ADMIN_PASSWORD=
# Kiosk path used by the editor. Customize only for reverse-proxy routing.
ADMIN_KIOSK_PATH=/kiosk

# Optional JPEG output for legacy player devices.
BINARY_EMOTIONS_ADDON=false
BINARY_EMOTIONS_LIMIT=10
