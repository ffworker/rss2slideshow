# Set to an interface reachable from your signage Pi; apply firewall restrictions.
BIND_IP=127.0.0.1

# existing host-mounted SMB/NFS folder, or a normal local image folder
MEDIA_DIR=./content/photos

# browser clock: pick an IANA timezone, eg Europe/Berlin or UTC
DISPLAY_TZ=Europe/Berlin
# seconds between slides in the browser player (not Binary Emotions)
SLIDE_SECONDS=15
